#!/bin/sh
set -eu
cd "$(dirname "$0")"
if [ "$(uname -s)" != Darwin ]; then
    echo "Meto requires macOS with a Metal-capable GPU." >&2
    exit 1
fi

if [ "${1:-}" = setup ]; then
    git submodule update --init
    if command -v uv >/dev/null 2>&1; then
        uv venv --allow-existing --python 3.13 .build/catalog-env
        uv pip install --python .build/catalog-env/bin/python -r Tools/requirements.txt
    else
        if ! command -v "${PYTHON:-python3.13}" >/dev/null 2>&1; then
            echo "Install uv or Python 3.13, then rerun ./meto setup. See README.md." >&2
            exit 1
        fi
        "${PYTHON:-python3.13}" -m venv .build/catalog-env
        .build/catalog-env/bin/python -m pip install -r Tools/requirements.txt
    fi
    exec ./meto doctor
fi

native() {
    if ! xcrun --find swiftc >/dev/null 2>&1; then
        echo "Install Apple's Command Line Tools with xcode-select --install, then retry." >&2
        exit 1
    fi
    make -s .build/meto
    .build/meto "$@"
}
catalog() {
    if [ ! -x .build/catalog-env/bin/python ]; then
        echo "Run ./meto setup once to prepare the extended catalog." >&2
        exit 1
    fi
    .build/catalog-env/bin/python Tools/catalog.py "$@"
}

case "${1:-help}" in
    list|show|practice) exec /usr/bin/python3 Tools/course.py "$@" ;;
    check|smoke|bench)
        case "${2:-all}" in
            all)
                case "$1" in
                    check|smoke) native check all "${3:-solution}"; catalog "$@" ;;
                    bench)
                        case "${3:-}" in
                            ""|--performance) native bench all ;;
                            *) native bench all "$3" ;;
                        esac
                        catalog "$@" ;;
                esac ;;
            1|01|2|02|3|03|4|04|5|05|6|06)
                if [ "$1" = smoke ]; then shift; native check "$@"; else native "$@"; fi ;;
            *) catalog "$@" ;;
        esac ;;
    doctor) native doctor
        if [ -x .build/catalog-env/bin/python ]; then
            .build/catalog-env/bin/python -c 'import torch; print(f"Catalog backend: PyTorch {torch.__version__}, MPS available: {torch.backends.mps.is_available()}"); raise SystemExit(not torch.backends.mps.is_available())'
        fi ;;
    help|--help|-h) cat <<'HELP'
Meto — local macOS compute challenges
  ./meto list                  Show all upstream IDs
  ./meto show ID               Read the problem in the terminal
  ./meto doctor                Check the local compiler and GPU
  ./meto setup                 Install catalog dependencies once
  ./meto check [ID|all]        Run correctness cases (default: all)
  ./meto smoke [ID|all]        Run examples across the course
  ./meto practice ID           Create an editable practice file
  ./meto check ID practice     Check your own implementation
  ./meto bench ID              Warm up, validate, then time locally
  ./meto bench ID --performance   Use upstream size (lessons 7 onward)
HELP
        ;;
    *) echo "Unknown command. Run ./meto help." >&2; exit 2 ;;
esac
